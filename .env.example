# Generate secret: openssl rand -base64 32
AUTH_SECRET=

# App URL (OAuth callback base)
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 邮箱验证码 — https://resend.com
# 生产须配 RESEND_API_KEY；开发不配则验证码打印在终端。
RESEND_API_KEY=
# 发件人。注意：未验证自有域名时使用 onboarding@resend.dev，Resend 只允许发到「注册 Resend 时用的邮箱」。
# 要对任意用户邮箱发信：在 Resend 添加并验证域名后，填写例如 AUTH_EMAIL_FROM=Ave <noreply@你的域名.com>
AUTH_EMAIL_FROM=
