# 必填：加密 Cookie / JWT。缺失时线上会出现 /api/auth/session 500、Auth.js「server configuration」错误。
# 生成：npx auth secret   或   openssl rand -base64 32
# 兼容旧名：也可使用 NEXTAUTH_SECRET（与 AUTH_SECRET 二选一即可）
AUTH_SECRET=

# 线上必须与浏览器地址一致（含 https），否则 OAuth 与 Session 易失败。
# 本地：http://localhost:3000   线上示例：https://你的项目.vercel.app
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 邮箱验证码 — https://resend.com
# 生产须配 RESEND_API_KEY；开发不配则验证码打印在终端。
RESEND_API_KEY=
# 发件人。注意：未验证自有域名时使用 onboarding@resend.dev，Resend 只允许发到「注册 Resend 时用的邮箱」。
# 要对任意用户邮箱发信：在 Resend 添加并验证域名后，填写例如 AUTH_EMAIL_FROM=Ave <noreply@你的域名.com>
AUTH_EMAIL_FROM=
